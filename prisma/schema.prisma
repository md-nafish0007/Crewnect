generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Student {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  gender    String?  @default("other")
  major     String?
  bio        String?
  year       String?
  techStacks String?
  avatarUrl  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model OtpVerification {
  id        String   @id @default(cuid())
  email     String   @unique
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model GlobalMessage {
  id        String   @id @default(cuid())
  text      String
  user      String
  createdAt DateTime @default(now())
}
